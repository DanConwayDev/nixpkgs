+fn git_io_failure(error: std::io::Error) -> Response<Full<Bytes>> {
+    eprintln!("Failed to collect git output: {error}");
+    Response::builder()
+        .status(StatusCode::INTERNAL_SERVER_ERROR)
+        .body(Full::new(Bytes::from("Failed to collect git output")))
+        .unwrap()
+}
